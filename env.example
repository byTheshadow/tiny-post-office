# 复制为 .env 后按需修改
PORT=3000
# 放在 nginx 后面保持 127.0.0.1；想直接暴露才改成 0.0.0.0（强烈建议走 HTTPS）
HOST=127.0.0.1
# 暗号位数（纯数字）。改了之后要重新运行 npm run setup
PIN_LENGTH=6
SESSION_DAYS=90
# 在 nginx 等反向代理后面时设为 1，才能拿到真实 IP 做防爆破
TRUST_PROXY=0
# auto：按 x-forwarded-proto 判断；1：强制 Secure Cookie；0：关闭（仅本地调试）
COOKIE_SECURE=auto
# Service Worker 出问题时设为 1，所有客户端下次打开会自动注销它
SW_KILL=0
